# Kuznitsa / Printer Dashboard — environment variables
#
# Copy this file to `.env` next to main.py and uncomment the values you need:
# `python main.py` reads it at start. OR set these variables in your process
# manager (a systemd unit `Environment=` line, docker-compose.yml `environment:`)
# — a variable already set there wins over the same key in `.env`.
# Format: KEY=VALUE, one per line; `#` starts a comment; quotes are optional.
# `.env` itself is gitignored — never commit real secrets.
#
# Everything here is OPTIONAL: the app boots with safe defaults and generates
# what it needs on first run (see notes below).

# --- Auth & security ---------------------------------------------------------

# JWT signing secret. If unset, the app generates a random one on first boot and
# persists it in users.db, so sessions survive restarts. Set this to pin/rotate
# the key explicitly. Changing it invalidates every issued token at once.
#   Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# FORGE_JWT_SECRET=

# First-run admin account. Username defaults to "admin". If FORGE_ADMIN_PASSWORD
# is unset, a random password is generated and printed ONCE to the log on first
# boot — read it there, log in, and change it. Set both to choose your own.
# FORGE_ADMIN_USERNAME=admin
# FORGE_ADMIN_PASSWORD=

# Cookie Secure flag. Default on (cookies sent only over HTTPS) — correct behind
# a TLS reverse proxy. Set to 0 only if you serve the app over plain HTTP: with 1
# over http:// the browser drops the login cookie and sign-in does not stick.
# COOKIE_SECURE=1

# Reverse proxies allowed to pass the real client address (X-Real-IP /
# X-Forwarded-For) — the login rate limit counts per address. A comma list of
# IPs or CIDR networks. In Docker behind nginx/Caddy on the host add the bridge
# gateway the requests come from (`docker compose logs` shows it), e.g.
# 127.0.0.1,::1,172.18.0.1
# FORGE_TRUSTED_PROXIES=127.0.0.1,::1

# --- Web server --------------------------------------------------------------

# Bind address for the built-in server. Default 127.0.0.1 (loopback only) is
# safest behind a reverse proxy / SSH tunnel. Set 0.0.0.0 to expose it directly.
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# --- Polling -----------------------------------------------------------------

# How often (seconds) to poll each printer — values under 30 are raised to 30 —
# and the max concurrent poll workers.
# POLL_INTERVAL=5
# MAX_WORKERS=10

# Live card refresh (seconds) from the printers' own telemetry, between polls;
# 0 = off (cards then change only on each poll, at least 30 s apart).
# FORGE_LIVE_REFRESH_S=2

# --- Bambu -------------------------------------------------------------------

# Verify each Bambu printer's MQTT TLS certificate against Bambu's own CAs
# (bundled in app/vendor/pybambu/certs). Default: empty = encrypted but NOT
# verified, as with the old pybambu 1.0.1. "*" = every Bambu printer, or a comma
# list of models as entered in Admin → Printers, e.g. "X1C,P2S". A model whose
# certificate chain is not covered by the bundled CAs then cannot connect (the
# log shows SSLCertVerificationError), so enable models one at a time and watch
# them come online. Verification also needs a correct system clock. A printer
# that fails verification is retried every second, without end (a full TLS
# handshake each time; the log repeats the error once per 10 minutes), so take
# its model off the list promptly.
# FORGE_BAMBU_TLS_VERIFY=

# --- History and automation ----------------------------------------------------

# Days to keep the state history, printer notifications and the AMS history.
# HISTORY_RETENTION_DAYS=90

# Days to keep finished prints in the print journal (at least 1).
# JOBS_RETENTION_DAYS=730

# The farm's time zone for the auto-drying start window, minutes from UTC
# (180 = UTC+3; 120 = UTC+2; -300 = UTC-5).
# FORGE_TZ_OFFSET_MIN=180

# -----------------------------------------------------------------------------
# NOT set here — managed in the app's database, edited from the UI:
#   * Printer fleet (hosts, access codes, serials) — Admin → Printers.
#   * Telegram bot token, chat id, notification templates — Settings → Telegram.
#   * Outbound proxy list for the Telegram bot — Settings → Proxy.
# These live in printer_history.db / users.db, not in env or code.
